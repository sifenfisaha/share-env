{
  "name": "@sifenfisaha/share-env",
  "version": "0.2.0",
  "description": "Securely share .env files with your team through git — encrypted with a passphrase, no server needed.",
  "type": "module",
  "bin": {
    "share-env": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifenfisaha/share-env.git"
  },
  "homepage": "https://share-env.seefun.dev",
  "bugs": {
    "url": "https://github.com/sifenfisaha/share-env/issues"
  },
  "author": "sifenfisaha",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "prepublishOnly": "npm run typecheck && npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "encryption",
    "cli",
    "team"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "diff": "^8.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
